{
  "manifest_version": 3,
  "name": "WriteSense AI",
  "description": "Grammar, clarity, and research assistance for Overleaf",
  "version": "1.0",

  "permissions": [
    "activeTab",
    "scripting"
  ],

  "host_permissions": [
    "https://www.overleaf.com/*",
    "http://127.0.0.1:*/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://www.overleaf.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}

